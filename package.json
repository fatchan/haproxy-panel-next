    "lint": "npx eslint --fix . && npx next lint",
    "restart-minimal": "npm run build && pm2 restart ecosystem.config.cjs --only \"autorenew,healthcheck-main,healthcheck-worker,sync-main,webapp\" --env production",
    "toggle-sync": "pm2 ls | grep -E \"autorenew|sync-main|healthcheck-main\" | grep -q \"stopped\" && pm2 start autorenew sync-main healthcheck-main || pm2 stop autorenew sync-main healthcheck-main",
    "migrate": "node migrate.js",
    "update": "pm2 stop ecosystem.config.cjs && git pull && npm run migrate && npm run build && pm2 restart ecosystem.config.cjs --env production"
  },
